      value: Roomprefab
      objectReference: {fileID: 0}
    - target: {fileID: 4826966793828585757, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: m_OnClick.m_PersistentCalls.m_Calls.Array.data[0].m_Arguments.m_IntArgument
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5793661249678209550, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: m_OnClick.m_PersistentCalls.m_Calls.Array.data[0].m_Arguments.m_IntArgument
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.name
      value: Player
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.size
      value: 26
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[0].sentence
      value: Here. For you, my milk-fearing friend.
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[1].sentence
      value: 'Thank you. And if you ever need something, feel free to ask me. '
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[2].sentence
      value: ' I will do so. Possibly very soon. Depending on if I need something someone else needs.'
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[3].sentence
      value: "I don\u2019t know what that really means but sure."
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[4].sentence
      value: 'Hey, was that milk thing actually true? '
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[5].sentence
      value: Oh, no. I was just joking. Haha.
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[6].sentence
      value: Oh. Haha. Okay cool.
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[7].sentence
      value: Let's go play some games now.
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[8].sentence
      value: '(THREE HOURS LATER)


        Haha! Beat you again!'
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[9].sentence
      value: "You\u2019re way too good at this. I\u2019m gonna go get something to drink."
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[10].sentence
      value: Okaaaaay!
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[11].sentence
      value: "Hmm\u2026 I could do with some milk right about now\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[12].sentence
      value: Wh- What was that?
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[13].sentence
      value: ' I said I could DRINK SOME MILK RIGHT NOW!

'
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[14].sentence
      value: "N-No\u2026. Nonononono. Anything but that!"
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[15].sentence
      value: 'But you said it was a joke!

'
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[16].sentence
      value: "All the memories\u2026 they\u2019re coming back! I wasn\u2019t lying. I really am afraid of milk. Milk\u2026. It killed my grandma, okay?! She\u2026 She was drinking milk and choked on it. I tried to help, but it was too late. She was dead.\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[17].sentence
      value: "That\u2019s horrible! But why even have milk in your fridge in the first place then??!!"
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[18].sentence
      value: ' To keep me grounded. If I ever get too comfortable, I can just stare at it and renmind myself of the bad times.'
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[19].sentence
      value: 'You might need some help.

'
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[20].sentence
      value: "Hah. Maybe. ...Do you\u2026 Wanna play some more?"
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[21].sentence
      value: "Sure. I\u2019ll just grab some water.\n"
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[22].sentence
      value: "W-W-Water\u2026?\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[23].sentence
      value: 'Did water kill your dad?


'
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[24].sentence
      value: "No. I\u2019m just joking. He died to cancer. Haha"
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[25].sentence
      value: Jesus
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[26].sentence
      value: ' I said I could DRINK SOME MILK RIGHT NOW!

'
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[0].nextEvent.m_PersistentCalls.m_Calls.Array.size
