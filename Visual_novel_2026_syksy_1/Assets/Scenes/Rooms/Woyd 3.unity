    - target: {fileID: 4354939644210601516, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: m_Name
      value: Roomprefab
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.name
      value: Player
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.size
      value: 16
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[0].sentence
      value: Here. A genuine Genshin Impact poster. For you.
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[1].sentence
      value: 'This is incredible. Thank you! My chances of winning have been tripled! '
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[2].sentence
      value: Wonderful to hear!
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[3].sentence
      value: Wanna come play some gay shit with me?
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[4].sentence
      value: 'Of course. As far as I can tell, all gaming is gay. '
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[5].sentence
      value: Touche.
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[6].sentence
      value: ' Nice place.'
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[7].sentence
      value: Thanks man. I decorated it with as much stuff I like as possible. And then my cats knock it all down.
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[8].sentence
      value: You draw too?
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[9].sentence
      value: " Yup. But I haven\u2019t been drawing as much, since my drawing tablet broke down."
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[10].sentence
      value: Oh no.
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[11].sentence
      value: "Yeeeah\u2026 My audience has been begging me to post but I had to tell them the news. No more yaoi until the tablet\u2019s fixed."
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[12].sentence
      value: Perhaps I could help you with this.
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[13].sentence
      value: 'You can fix tablets?

'
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[14].sentence
      value: "Nope. I\u2019m finding you a new one from someone else."
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[15].sentence
      value: ' Seems a little weird but ok. If you can find someone.'
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[16].sentence
      value: 'You can fix tablets?

'
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[17].sentence
      value: " So are we\u2026 still friends?"
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[18].sentence
      value: "Eh. Well, you\u2019re pretty chill. So I guess we can still play games together some time. Just say when you wanna hang out, dude. No need to watch me from a distance."
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[19].sentence
      value: 'Nice! Thanks for hanging out, friend! '
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[20].sentence
      value: 'Nice! Thanks for hanging out, friend! '
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[21].sentence
      value: "You really think so? My therapist says the same\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[22].sentence
      value: Seriously though. We have to get rid of this corpse.
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[23].sentence
      value: "Good idea. You go fetch a shovel, I\u2019ll go find a nice place in the backyard."
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[24].sentence
      value: "Good idea. You go fetch a shovel, I\u2019ll go find a nice place in the backyard."
      objectReference: {fileID: 0}
