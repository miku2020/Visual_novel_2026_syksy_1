--- !u!1001 &1989677949
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 188947032312532601, guid: 102c91bea7beb6f499cc324fe4f7558e, type: 3}
      propertyPath: dialogue.name
      value: Player
      objectReference: {fileID: 0}
    - target: {fileID: 188947032312532601, guid: 102c91bea7beb6f499cc324fe4f7558e, type: 3}
      propertyPath: dialogue.lines.Array.size
      value: 11
      objectReference: {fileID: 0}
    - target: {fileID: 188947032312532601, guid: 102c91bea7beb6f499cc324fe4f7558e, type: 3}
      propertyPath: dialogue.lines.Array.data[0].sentence
      value: Here! I got you what you asked for!
      objectReference: {fileID: 0}
    - target: {fileID: 188947032312532601, guid: 102c91bea7beb6f499cc324fe4f7558e, type: 3}
      propertyPath: dialogue.lines.Array.data[1].sentence
      value: "No fucking way. You\u2019ve gotta be fucking kidding me. I bet you feel reeeeal fucking good now you sick freak."
      objectReference: {fileID: 0}
    - target: {fileID: 188947032312532601, guid: 102c91bea7beb6f499cc324fe4f7558e, type: 3}
      propertyPath: dialogue.lines.Array.data[2].sentence
      value: Haha. I do! Helping is my passion!
      objectReference: {fileID: 0}
    - target: {fileID: 188947032312532601, guid: 102c91bea7beb6f499cc324fe4f7558e, type: 3}
      propertyPath: dialogue.lines.Array.data[3].sentence
      value: Fuck you.
      objectReference: {fileID: 0}
    - target: {fileID: 188947032312532601, guid: 102c91bea7beb6f499cc324fe4f7558e, type: 3}
      propertyPath: dialogue.lines.Array.data[4].sentence
      value: So. What else can I do for you?
      objectReference: {fileID: 0}
    - target: {fileID: 188947032312532601, guid: 102c91bea7beb6f499cc324fe4f7558e, type: 3}
      propertyPath: dialogue.lines.Array.data[5].sentence
      value: "You want to help MORE? Well\u2026 I guess I do have quite an\u2026 \u201Dunusual\u201D request."
      objectReference: {fileID: 0}
    - target: {fileID: 188947032312532601, guid: 102c91bea7beb6f499cc324fe4f7558e, type: 3}
      propertyPath: dialogue.lines.Array.data[6].sentence
      value: Sure! What is it?
      objectReference: {fileID: 0}
    - target: {fileID: 188947032312532601, guid: 102c91bea7beb6f499cc324fe4f7558e, type: 3}
      propertyPath: dialogue.lines.Array.data[7].sentence
      value: "It\u2019s this thing called a \u201Dhyperbolic rhombic dodecahedron\u201D. It\u2019s my favourite shape and I still don\u2019t have it in my collection. Can you go and find one for me?"
      objectReference: {fileID: 0}
    - target: {fileID: 188947032312532601, guid: 102c91bea7beb6f499cc324fe4f7558e, type: 3}
      propertyPath: dialogue.lines.Array.data[8].sentence
      value: A hyperbolic rhom.. what?
      objectReference: {fileID: 0}
    - target: {fileID: 188947032312532601, guid: 102c91bea7beb6f499cc324fe4f7558e, type: 3}
      propertyPath: dialogue.lines.Array.data[9].sentence
      value: "Ugh. Are you stupid or something? A \u201Dhyperbolic rhombic dodecahedron\u201D. If you can get one for me, I might let you inside my house and we can hang or something."
      objectReference: {fileID: 0}
    - target: {fileID: 188947032312532601, guid: 102c91bea7beb6f499cc324fe4f7558e, type: 3}
      propertyPath: dialogue.lines.Array.data[10].sentence
      value: "I\u2019ll certainly try!"
      objectReference: {fileID: 0}
    - target: {fileID: 188947032312532601, guid: 102c91bea7beb6f499cc324fe4f7558e, type: 3}
      propertyPath: dialogue.lines.Array.data[0].nextEvent.m_PersistentCalls.m_Calls.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 188947032312532601, guid: 102c91bea7beb6f499cc324fe4f7558e, type: 3}
      propertyPath: dialogue.lines.Array.data[1].nextEvent.m_PersistentCalls.m_Calls.Array.size
      value: 1
      objectReference: {fileID: 0}
