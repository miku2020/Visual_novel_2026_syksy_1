    - target: {fileID: 4354939644210601516, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: m_Name
      value: Roomprefab
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.name
      value: Player
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.size
      value: 17
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[0].sentence
      value: Here! I also got you Satisfactory and Binding Of Isaac. On the DS.
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[1].sentence
      value: "What?! Those are my favourite games\u2026 I didn\u2019t even know they were availbale on DS!!! Are you SURE you haven\u2019t been stalking me?"
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[2].sentence
      value: Heh! Just got pretty lucky I guess!
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[3].sentence
      value: "Seriously. I\u2019ve had someone stalk me for like a year I think. They watched me through my windows every night. It ended when they got hit by a car while running after me on the street. Even today, I must have my curtains permanently closed and maintain a high walking speed when outside."
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[4].sentence
      value: Holy shit.
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[5].sentence
      value: So... You aren't a stalker?
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[6].sentence
      value: No! Of course not!!
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[7].sentence
      value: "That\u2019s good. I believe you. Yay!! I made a friend!"
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[8].sentence
      value: Yippee... haha....
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[9].sentence
      value: Now we can play some games!
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[10].sentence
      value: (3 HOURS LATER)
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[11].sentence
      value: That was fun. Come back some other time, okay? WAIT!!
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[12].sentence
      value: Huh?
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[13].sentence
      value: "I want to draw you something. Where did I put my sketchbook\u2026 Oh no. It must\u2019ve slipped out of my backpack when I came home last night!\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[14].sentence
      value: "That was your sketchbook? I remember seeing a sketchbook sitting in the hallway and just gave it to someone who thought It was theirs. Wish I could remember who It was\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[15].sentence
      value: "Can you please return it? Someone could see all the math I\u2019ve written and think I\u2019m a nerd\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[16].sentence
      value: f course, It was my mistake after all. Brb!
      objectReference: {fileID: 0}
    - target: {fileID: 7968387475252959001, guid: 3fd148b7692c7134dba83b213cd75b37, type: 3}
      propertyPath: dialogue.lines.Array.data[0].nextEvent.m_PersistentCalls.m_Calls.Array.size
      value: 1
      objectReference: {fileID: 0}
